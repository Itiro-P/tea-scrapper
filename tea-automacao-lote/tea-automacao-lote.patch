+            if limit is not None:classification_queue=classification_queue[:limit]
+            classification_ids={a['appId'] for a in classification_queue}
+            if retry_errors:
+                with db:
+                    db.executemany("UPDATE classifications SET state='pending',error=NULL WHERE app_id=? AND state='error'",
+                                   [(key,) for key in classification_ids])
+            journal(out,{'event':'start','model':identity['name'],'model_digest':identity['digest'],'workers':workers,
+                'timeout':timeout,'max_attempts':max_attempts,'limit':limit,'app_ids':list(app_ids),
+                'retry_errors':retry_errors,'stop_after_errors':stop_after_errors,'export_every':export_every})
+            class_counts=run_classification_queue(out,classification_queue,config,identity,client,max_attempts,
