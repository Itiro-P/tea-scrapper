+def csv_file(path,fields,rows):
+    temp=path.with_suffix(path.suffix+'.tmp')
+    with temp.open('w',encoding='utf-8-sig',newline='') as f:
+        writer=csv.DictWriter(f,fieldnames=fields);writer.writeheader();writer.writerows(rows)
+    temp.replace(path)
