+def run_classification_queue(out, queue, config, identity, client, attempts, workers, db,
+                             cancel, callback, export_every, stop_after_errors):
+    counts={'scheduled_classifications':len(queue),'finished_classifications_this_run':0,
+            'classification_errors_this_run':0,'stop_reason':None}
+    executor=ThreadPoolExecutor(max_workers=workers);active={};cursor=0;consecutive=0
+    try:
+        while active or cursor<len(queue):
+            while not cancel.is_set() and not counts['stop_reason'] and cursor<len(queue) and len(active)<workers:
+                app=queue[cursor];cursor+=1
+                with db:db.execute("UPDATE classifications SET state='running',error=NULL WHERE app_id=?",(app['appId'],))
+                future=executor.submit(execute_classification,app,config,identity,client,attempts,cancel,callback)
+                active[future]=app
+            if not active:break
+            done,_=wait(active,timeout=0.5,return_when=FIRST_COMPLETED)
+            for future in done:
+                app=active.pop(future);result=future.result()
+                state='pending' if result['state']=='cancelled' else result['state']
+                with db:
+                    for attempt in result['attempts']:
+                        db.execute('INSERT INTO classification_attempts(app_id,started_at,elapsed,state,raw,error) VALUES(?,?,?,?,?,?)',
+                            (app['appId'],attempt['started_at'],attempt['elapsed'],attempt['state'],canonical(attempt['raw']),attempt['error']))
+                    db.execute('UPDATE classifications SET state=?,result=?,error=?,elapsed=elapsed+? WHERE app_id=?',
+                        (state,canonical(result['classification']) if result.get('classification') else None,
+                         result.get('error'),result['elapsed'],app['appId']))
+                counts['finished_classifications_this_run']+=1
+                if state=='error':counts['classification_errors_this_run']+=1
+                consecutive=consecutive+1 if result.get('transport') else 0
+                if result.get('deadline'):counts['stop_reason']='classification_timeout'
+                elif result.get('fatal'):counts['stop_reason']='ollama_http_configuration_error'
+                elif consecutive>=stop_after_errors:counts['stop_reason']='consecutive_transport_errors'
+                emit({'event':state,'stage':'classification','appId':app['appId'],'part':0,
+                      'decision':state if state in {'relevant','not_relevant','uncertain'} else None,
+                      'error':result.get('error')},callback)
+                if counts['finished_classifications_this_run']%export_every==0:export(out,db)
+            if cancel.is_set():counts['stop_reason']='interrupted'
+    except KeyboardInterrupt:
+        cancel.set();counts['stop_reason']='interrupted'
+    finally:
+        if counts['stop_reason']=='interrupted':cancel.set()
+        executor.shutdown(wait=True,cancel_futures=True)
+        with db:db.execute("UPDATE classifications SET state='pending' WHERE state='running'")
+    return counts
+
