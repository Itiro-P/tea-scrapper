+def status(out):
+    path=out/'checkpoint.sqlite3'
+    if not path.is_file():raise ValueError('Nenhuma execução iniciada; rode run após prepare/plan.')
+    db=sqlite3.connect(path.resolve().as_uri()+'?mode=ro',uri=True,timeout=10)
+    db.row_factory=sqlite3.Row
+    try:
+        if not db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='classifications'").fetchone():
+            raise ValueError('Checkpoint de versão antiga incompatível; use os CSVs existentes ou prepare uma nova pasta v3.')
+        db.execute('BEGIN')
+        return export(out,db,write_files=False)
+    finally:db.close()
