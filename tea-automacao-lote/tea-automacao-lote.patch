+def review_copy(out,destination):
+    destination=Path(destination).resolve()
+    with exclusive(out):
+        summary=export(out)
+        destination.mkdir(parents=True,exist_ok=False)
+        for name in ['apps.csv','funcionalidades.csv','taxonomia-para-revisao.csv','corpus.jsonl','resumo.json','run-manifest.json']:
+            shutil.copy2(out/name,destination/name)
+        (destination/'LEIA-ME.txt').write_text('Cópia congelada para revisão humana. Esta pasta não é atualizada pela extração.\nEm apps.csv, preencha relevance_human_decision (relevant/not_relevant/uncertain) e relevance_human_reviewer.\nEm funcionalidades.csv, preencha human_decision, human_name_correction e human_reviewer.\nSão candidatas assistidas por IA; não são padrão ouro independente.\n',encoding='utf-8')
+        return {'review_directory':str(destination),'apps':summary['apps'],'features':summary['feature_candidates'],'human_review':'pending'}
